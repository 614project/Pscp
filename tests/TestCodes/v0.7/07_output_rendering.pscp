// [PSCP v0.7 적합성 테스트] 출력 렌더링 규칙
// 관련 변경: B4 렌더링 표 (bool, double, char[], 2차원, 튜플 컬렉션, 보간 hole), B6 string 변환  (docs/pscp_v_0_7_changes.md)
// 0.6.7 결과:
//   - C# 오류: CS0178/CS1586 (중첩 builder lowering)
//   - 렌더링만 보면: True, 1E-05, 'd e s s e r t s', 2차원이 한 줄로 평탄화, 튜플 리스트도 한 줄
// 0.7 기대: 입력 07_output_rendering.in → 출력 07_output_rendering.out

int n =
int[n] a =

+= a.sum() % 2 == 0
+= 1.0 / 100000.0
+= 0.1 + 0.2
+= "stressed".reverse()

let grid = [0..<n -> i do [0..<n -> j do a[i] * a[j]]]
+= grid

List<(int, int)> pairs = [a -> x do (x, x * x)]
+= pairs

+= (a[0], "first")
+= $"{a[0] > 0} {2.5e-6}"
+= string ['o', 'k']
