// [PSCP v0.7.1 적합성 테스트] 조건부 할당 `a >= b`, `a <= b`
// 관련 변경: 스펙 §12.7 (0.7.1에서 추가), 부록 C (`chmin`/`chmax` 폐기 예정)
// `low >= v`는 `low = min low v`, `high <= v`는 `high = max high v`다. 문장 전체일 때만 이 뜻이고,
// 식 안이나 `=>` 본문, 조건, 괄호로 감싼 `(a >= b)`에서는 그대로 비교다.
// 0.7.1 기대: 입력 21_conditional_assignment.in → 출력 21_conditional_assignment.out

int h, w =
int[h][w] cost =

// 격자 최소 경로 합: 위나 왼쪽에서 오는 값 중 작은 쪽
let inf = int.MaxValue / 2
int[][] dp = [0..<h -> _ do [0..<w -> _ do inf]]
dp[0][0] = cost[0][0]
for r in 0..<h {
    for c in 0..<w {
        if r > 0 then dp[r][c] >= dp[r - 1][c] + cost[r][c]
        if c > 0 then dp[r][c] >= dp[r][c - 1] + cost[r][c]
    }
}
+= dp[h - 1][w - 1]

// 행마다 최댓값과 그 위치, 전체 최솟값
mut int low = inf
mut (int, int) best = (int.MinValue, -1)
for r in 0..<h {
    cost[r] -> v { low >= v }
    best <= (cost[r].max(), r)
}
+= (low, best)

// 비교로 남는 자리
bool fits(int v) => v <= low + 2
let flags = [0..<w -> c do cost[0][c] >= 3]
+= (fits(3), fits(9), flags)
