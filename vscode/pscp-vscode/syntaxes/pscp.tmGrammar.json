{
  "scopeName": "source.pscp",
  "name": "PSCP",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#section-labels"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.pscp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.pscp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.verbatim.pscp",
          "begin": "\\$@\"|@\\$\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.pscp",
              "match": "\"\"|\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.verbatim.pscp",
          "begin": "@\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.pscp",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "string.interpolated.double.pscp",
          "begin": "\\$\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pscp"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pscp"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.pscp",
              "match": "\\\\.|\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.pscp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.pscp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.pscp",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pscp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.pscp",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)(?:[uU][lL]?|[lL][uU]?|[fFdDmM])?\\b"
        }
      ]
    },
    "section-labels": {
      "patterns": [
        {
          "name": "invalid.illegal.section-label.pscp",
          "match": "^\\s*(?:public|private|protected|internal)\\s*:"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.pscp",
          "match": "\\b(?:public|private|protected|internal|static|readonly|const|params|abstract|sealed|partial)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.operator.new.pscp",
          "match": "\\bnew!"
        },
        {
          "name": "keyword.control.pscp",
          "match": "\\b(?:interface|namespace|continue|operator|default|finally|params|record|return|struct|switch|typeof|break|catch|class|throw|using|value|where|while|base|else|enum|init|then|this|when|with|and|for|get|let|mut|new|not|out|rec|ref|set|try|var|xor|as|do|if|in|is|or)\\b"
        },
        {
          "name": "constant.language.pscp",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.pscp",
          "match": "\\b(?:int|long|double|decimal|bool|char|string|void|List|LinkedList|Queue|Stack|HashSet|Dictionary|PriorityQueue|SortedSet|IEnumerable|IComparable|Comparer|Array)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.intrinsic.pscp",
          "match": "\\b(?:findLastIndex|lowerBound|upperBound|bitLength|findIndex|distinct|popcount|sortWith|mapFold|reverse|filter|sortBy|chmax|chmin|clamp|count|floor|index|maxBy|minBy|round|sumBy|ceil|copy|desc|find|fold|freq|scan|sort|sqrt|abs|all|any|asc|gcd|lcm|map|max|min|pow|sum)\\b"
        },
        {
          "name": "entity.name.function.pscp",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.pscp",
          "match": "(?<=\\.)\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "^\\s*(\\+?=)(?!=)",
          "captures": {
            "1": {
              "name": "keyword.operator.output.pscp"
            }
          }
        },
        {
          "name": "keyword.operator.output.pscp",
          "match": "(?<=then|else|do|;)\\s*\\+?=(?!=)"
        },
        {
          "name": "keyword.operator.input.pscp",
          "match": "=(?!=)\\s*(?=(?://.*)?$)"
        },
        {
          "name": "keyword.operator.pscp",
          "match": "<=>|\\.\\.<|\\.\\.=|\\.\\.|:=|=>|->|\\|>|<\\||&&|\\|\\||==|!=|<=|>=|\\+\\+|--|\\+=|-=|\\*=|/=|%=|[=+\\-*/%!^~?:<>.&|]"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.pscp",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.pscp"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.pscp"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#section-labels"
            },
            {
              "include": "#modifiers"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#functions"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    }
  }
}
